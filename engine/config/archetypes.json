{
  "catalogVersion": "1.0",
  "archetypes": [
    {
      "id": "asset_registry",
      "name": "台账与资产",
      "description": "管理分类、资产、责任人、状态和生命周期。",
      "allowedPlugins": ["asset_registry"],
      "requiredCapabilities": ["entity_crud", "relationships", "audit"]
    },
    {
      "id": "inspection_rectification",
      "name": "巡检与整改",
      "description": "管理计划、检查项、执行记录、异常、整改和复核闭环。",
      "allowedPlugins": ["inspection_rectification", "work_order_service"],
      "requiredCapabilities": ["entity_crud", "workflow", "transactions", "audit"]
    },
    {
      "id": "work_order_service",
      "name": "工单与服务",
      "description": "管理受理、分派、处理、复核、关闭和服务期限。",
      "allowedPlugins": ["work_order_service"],
      "requiredCapabilities": ["entity_crud", "workflow", "transactions", "audit"]
    },
    {
      "id": "inventory_batch",
      "name": "库存与批次",
      "description": "管理物料、批次、入库、领用、退库和库存预警。",
      "allowedPlugins": ["inventory_batch", "application_archive"],
      "requiredCapabilities": ["entity_crud", "relationships", "transactions", "audit"]
    },
    {
      "id": "project_task",
      "name": "项目与任务",
      "description": "管理项目、里程碑、任务、进度、风险和交付物。",
      "allowedPlugins": ["project_task", "application_archive"],
      "requiredCapabilities": ["entity_crud", "workflow", "relationships", "audit"]
    },
    {
      "id": "application_archive",
      "name": "申请与归档",
      "description": "管理申请、审批、证照、文件、到期提醒和归档。",
      "allowedPlugins": ["application_archive", "domain_document_bridge"],
      "requiredCapabilities": ["entity_crud", "workflow", "attachments", "audit"]
    },
    {
      "id": "domain_document_bridge",
      "name": "领域文档桥接",
      "description": "连接领域文档与申请归档能力。",
      "allowedPlugins": ["application_archive", "domain_document_bridge"],
      "requiredCapabilities": ["entity_crud", "relationships", "audit"]
    },
    {
      "id": "asset_work_order_bridge",
      "name": "资产工单桥接",
      "description": "连接资产台账与工单服务并约束资产停用。",
      "allowedPlugins": ["asset_registry", "work_order_service", "asset_work_order_bridge"],
      "requiredCapabilities": ["entity_crud", "relationships", "transactions", "audit"]
    },
    {
      "id": "asset_inspection_bridge",
      "name": "资产巡检桥接",
      "description": "连接资产台账与巡检计划、任务和历史。",
      "allowedPlugins": ["asset_registry", "inspection_rectification", "asset_inspection_bridge"],
      "requiredCapabilities": ["entity_crud", "relationships", "transactions", "audit"]
    },
    {
      "id": "inspection_work_order_bridge",
      "name": "巡检工单桥接",
      "description": "将巡检异常转换为整改工单并约束归档。",
      "allowedPlugins": ["inspection_rectification", "work_order_service", "inspection_work_order_bridge"],
      "requiredCapabilities": ["entity_crud", "workflow", "relationships", "transactions", "audit"]
    },
    {
      "id": "inventory_application_bridge",
      "name": "库存申请桥接",
      "description": "最终审批后扣减批次库存并保留流水关系。",
      "allowedPlugins": ["inventory_batch", "application_archive", "inventory_application_bridge"],
      "requiredCapabilities": ["entity_crud", "workflow", "relationships", "transactions", "audit"]
    },
    {
      "id": "project_archive_bridge",
      "name": "项目归档桥接",
      "description": "连接项目交付版本与归档文件并约束项目关闭。",
      "allowedPlugins": ["project_task", "application_archive", "project_archive_bridge"],
      "requiredCapabilities": ["entity_crud", "relationships", "attachments", "transactions", "audit"]
    }
  ]
}
