    foreach($definition in @($config.documents)){$id=[string]$definition.id;$docx=Join-Path $root ([string]$definition.docx);[void](Assert-QualityFile $docx $id);$metrics=Get-DocxQualityMetrics $docx $id;$referenceResult=$null;$referencePdf=$null;if($null-ne$definition.pdf){if($script:ReferencePdfCache.ContainsKey($metrics.sha256)){$referenceResult=$script:ReferencePdfCache[$metrics.sha256]}else{$referencePdf=Join-Path ([IO.Path]::GetTempPath()) ('.quality-reference-'+[guid]::NewGuid().ToString('N')+'.pdf')}};try{$wordPages=Get-WordQualityPageCount $docx $id $referencePdf;if($wordPages-ne$metrics.pageMetadata){Fail-Quality $id 'PAGE_METADATA'};$metrics.pages=$wordPages
            if($metrics.pages-lt[int]$definition.minPages-or$metrics.pages-gt[int]$definition.maxPages){Fail-Quality $id 'PAGES'};if($metrics.characters-lt[int]$definition.minCharacters){Fail-Quality $id 'CHARACTERS'};if($metrics.paragraphs-lt[int]$definition.minParagraphs){Fail-Quality $id 'PARAGRAPHS'};if($metrics.tables-lt[int]$definition.minTables){Fail-Quality $id 'TABLES'};$maxMedia=$definition.maxMedia;if($metrics.mediaHashes.Count-lt[int]$definition.minMedia-or($null-ne$maxMedia-and$metrics.mediaHashes.Count-gt[int]$maxMedia)){Fail-Quality $id 'MEDIA'};if(@($metrics.mediaHashes|Sort-Object -Unique).Count-ne$metrics.mediaHashes.Count){Fail-Quality $id 'MEDIA_DUPLICATE'}
            if($metrics.text-notmatch[regex]::Escape([string]$Facts.software.name)-or$metrics.text-notmatch[regex]::Escape([string]$Facts.software.version)){Fail-Quality $id 'TITLE'};foreach($heading in @($definition.requiredHeadings)){if(-not(@($metrics.headingTexts|Where-Object{$_-match[regex]::Escape([string]$heading)}).Count)){Fail-Quality $id 'HEADING'}};foreach($required in @($definition.requiredText)){if($metrics.text-notmatch[regex]::Escape([string]$required)){Fail-Quality $id 'HEADING'}}
            if($definition.moduleCoverage){foreach($module in @($Facts.modules)){if($metrics.text-notmatch[regex]::Escape([string]$module.name)){Fail-Quality $id 'MODULES'};if($id-eq'feature-table'){$sections=@($metrics.tableSections|Where-Object{$_.sectionPath-match[regex]::Escape([string]$module.name)});if($sections.Count-eq0){Fail-Quality $id 'MODULE_TABLES'};$commandLabels=@($Facts.commands|Where-Object{[string]$_.moduleId-eq[string]$module.id}|ForEach-Object{[string]$_.label});foreach($label in $commandLabels){if(-not@($sections|Where-Object{$_.text-match[regex]::Escape($label)}).Count){Fail-Quality $id 'MODULE_TABLES'}}}}};if($definition.entityCoverage){foreach($entity in @($Facts.entities|Where-Object{$_.isCore})){if($metrics.text-notmatch[regex]::Escape([string]$entity.name)){Fail-Quality $id 'ENTITIES'};if($id-eq'database-design'){$sections=@($metrics.tableSections|Where-Object{$_.sectionPath-match[regex]::Escape([string]$entity.name)});if($sections.Count-eq0){Fail-Quality $id 'ENTITY_TABLES'};$fieldLabels=@($entity.fields|ForEach-Object{if($null-ne$_.PSObject.Properties['name']){[string]$_.name}else{[string]$_.id}});if($fieldLabels.Count-and-not@($sections|Where-Object{$sectionText=[string]$_.text;@($fieldLabels|Where-Object{$sectionText-match[regex]::Escape($_)}).Count}).Count){Fail-Quality $id 'ENTITY_TABLES'}}}}
            if($id-eq'manual'){$steps=@($Facts.workflows|ForEach-Object{@($_.steps)});$workflowRecords=@($metrics.paragraphRecords|Where-Object{$_.sectionPath-match'完整业务流程'});$starts=[Collections.Generic.List[int]]::new();$cursor=-1;foreach($step in $steps){$matched=-1;$ordinal=$starts.Count+1;for($recordIndex=$cursor+1;$recordIndex-lt$workflowRecords.Count;$recordIndex++){$record=$workflowRecords[$recordIndex];$explicitStep=[string]$record.text-match('^步骤\s*'+$ordinal+'\s*[：:]');if(($record.numbered-or$explicitStep)-and[string]$record.text-match[regex]::Escape([string]$step.label)){$matched=$recordIndex;break}};if($matched-lt0){Fail-Quality $id 'WORKFLOW'};$starts.Add($matched);$cursor=$matched};for($stepIndex=0;$stepIndex-lt$steps.Count;$stepIndex++){$end=if($stepIndex+1-lt$starts.Count){$starts[$stepIndex+1]-1}else{$workflowRecords.Count-1};$block=@($workflowRecords[$starts[$stepIndex]..$end]|ForEach-Object text)-join' ';foreach($property in @('prerequisite','result','failure')){if($null-ne$steps[$stepIndex].PSObject.Properties[$property]-and$block-notmatch[regex]::Escape([string]$steps[$stepIndex].$property)){Fail-Quality $id 'WORKFLOW'}}}}
            if($definition.internalIdScan){Test-InternalQualityIds $Facts $metrics.text $id};Test-ForbiddenQualityText $metrics.scanText $id
            if($id-eq'manual'){if(-not(Test-ExactQualityArray @($metrics.mediaHashes|Sort-Object) @($screenshotHashes|Sort-Object))){Fail-Quality $id 'MEDIA_BINDING'}}elseif($id-eq'application-info'){$expectedBookmarks=@('category','classification','company_date','completion_date','development_hardware','development_os','development_purpose','development_tools','industry','language','main_functions','runtime_hardware','runtime_platform','runtime_support','short_name','software_name','source_quantity','technical_features','version')|ForEach-Object{'app_'+$_}|Sort-Object;if(-not(Test-ExactQualityArray @($metrics.bookmarks|Where-Object{$_-like'app_*'}|Sort-Object) $expectedBookmarks)){Fail-Quality $id 'BOOKMARKS'}}elseif($id-eq'source'){if($metrics.pages-ne[int]$SourcePlan.expectedPageCount-or[string]$metrics.variables.SourceManifestSha256-cne[string]$Facts.source.sha256-or[string]$metrics.variables.SourceSelectionSha256-cne[string]$SourcePlan.selectionSha256){Fail-Quality $id 'DIGEST'};Test-QualitySourceDocument $metrics $sourceExpectation}
            $pdfMetrics=$null;if($null-ne$definition.pdf){$pdf=Join-Path $root ([string]$definition.pdf);[void](Assert-QualityFile $pdf $id);$pdfResult=Get-PdfQualityPageCount $pdf $id;if($null-eq$referenceResult){$referenceResult=Get-PdfQualityPageCount $referencePdf $id;$script:ReferencePdfCache[$metrics.sha256]=$referenceResult};$pdfBound=$pdfResult.pages-eq$metrics.pages-and(Test-ExactQualityArray $pdfResult.pageDigests $referenceResult.pageDigests);for($bindingAttempt=2;-not$pdfBound-and$bindingAttempt-le3;$bindingAttempt++){$retryPdf=Join-Path ([IO.Path]::GetTempPath()) ('.quality-reference-'+[guid]::NewGuid().ToString('N')+'.pdf');try{$retryPages=Get-WordQualityPageCount $docx $id $retryPdf;$retryResult=Get-PdfQualityPageCount $retryPdf $id;$pdfBound=$retryPages-eq$metrics.pages-and$pdfResult.pages-eq$metrics.pages-and(Test-ExactQualityArray $pdfResult.pageDigests $retryResult.pageDigests);if($pdfBound){$referenceResult=$retryResult;$script:ReferencePdfCache[$metrics.sha256]=$retryResult}}finally{if(Test-Path -LiteralPath $retryPdf){Remove-Item -LiteralPath $retryPdf -Force -ErrorAction SilentlyContinue}}};if(-not$pdfBound){Fail-Quality $id 'PDF_BINDING'};$pdfMetrics=[pscustomobject]@{fileName=[string]$definition.pdf;sha256=Get-QualityHash $pdf;pages=$pdfResult.pages;nonblank=$pdfResult.nonblank}}
            $receiptDocuments.Add([pscustomobject]@{id=$id;fileName=[string]$definition.docx;sha256=$metrics.sha256;pages=$metrics.pages;characters=$metrics.characters;paragraphs=$metrics.paragraphs;tables=$metrics.tables;mediaCount=$metrics.mediaHashes.Count;mediaSha256=@($metrics.mediaHashes);pdf=$pdfMetrics})
        }finally{if($null-ne$referencePdf-and(Test-Path -LiteralPath $referencePdf)){Remove-Item -LiteralPath $referencePdf -Force -ErrorAction SilentlyContinue}}
    }
    $factsJson=ConvertTo-CanonicalQualityJson $Facts;$factsSha=[BitConverter]::ToString(([Security.Cryptography.SHA256]::Create().ComputeHash([Text.UTF8Encoding]::new($false).GetBytes($factsJson)))).Replace('-','').ToLowerInvariant();$screenshotDigest=[BitConverter]::ToString(([Security.Cryptography.SHA256]::Create().ComputeHash([Text.UTF8Encoding]::new($false).GetBytes((@($screenshotHashes|Sort-Object)-join"`n"))))).Replace('-','').ToLowerInvariant()
    return [pscustomobject]@{receiptVersion='1.0';status='passed';factsSha256=$factsSha;executableSha256=[string]$Facts.evidence.executableSha256;resourceManifestSha256=[string]$Facts.evidence.resourceManifestSha256;blueprintSha256=[string]$Facts.evidence.blueprintSha256;sourceManifestSha256=[string]$Facts.source.sha256;sourceSelectionSha256=[string]$SourcePlan.selectionSha256;screenshotManifestSha256=[string]$Facts.evidence.screenshotManifestSha256;screenshotSha256=$screenshotDigest;documents=$receiptDocuments.ToArray()}
}

