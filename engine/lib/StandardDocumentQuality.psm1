Set-StrictMode -Version Latest
$ErrorActionPreference='Stop'
$script:QualityConfigPath=Join-Path (Split-Path -Parent $PSScriptRoot) 'config\standard-document-quality.json'
$script:WordInspectorPath=Join-Path (Split-Path -Parent $PSScriptRoot) 'template\tools\word-page-inspector.ps1'
$script:PdfInspectorPath=Join-Path (Split-Path -Parent $PSScriptRoot) 'template\tools\pdf-page-inspector.ps1'
