function Fail-Quality([string]$Id,[string]$Code){throw ('QUALITY_'+$Id.ToUpperInvariant().Replace('-','_')+'_'+$Code)}
function Get-QualityHash([string]$Path){return (Get-FileHash -LiteralPath $Path -Algorithm SHA256).Hash.ToLowerInvariant()}
function Test-ExactQualityArray($Left,$Right){$a=@($Left);$b=@($Right);if($a.Count-ne$b.Count){return $false};for($i=0;$i-lt$a.Count;$i++){if([string]$a[$i]-cne[string]$b[$i]){return $false}};return $true}
function ConvertTo-CanonicalQualityJson($Value){
    if($null-eq$Value){return 'null'}
    if($Value-is[bool]){return $(if($Value){'true'}else{'false'})}
    if($Value-is[string]-or$Value-is[char]){return (ConvertTo-Json -InputObject ([string]$Value) -Compress)}
    if($Value-is[byte]-or$Value-is[int16]-or$Value-is[int32]-or$Value-is[int64]-or$Value-is[single]-or$Value-is[double]-or$Value-is[decimal]){return [Convert]::ToString($Value,[Globalization.CultureInfo]::InvariantCulture)}
    if($Value-is[Collections.IDictionary]){$keys=@($Value.Keys|ForEach-Object{[string]$_}|Sort-Object);return ('{'+(($keys|ForEach-Object{(ConvertTo-Json -InputObject $_ -Compress)+':'+(ConvertTo-CanonicalQualityJson $Value[$_])})-join',')+'}')}
    if($Value-is[Collections.IEnumerable]){return ('['+((@($Value)|ForEach-Object{ConvertTo-CanonicalQualityJson $_})-join',')+']')}
    $properties=@($Value.PSObject.Properties|Where-Object MemberType -in @('NoteProperty','Property')|Sort-Object Name);return ('{'+(($properties|ForEach-Object{(ConvertTo-Json -InputObject $_.Name -Compress)+':'+(ConvertTo-CanonicalQualityJson $_.Value)})-join',')+'}')
}
function Get-WordQualityPageCount([string]$Path,[string]$Id,[string]$ReferencePdfPath){$key=Get-QualityHash $Path;if([string]::IsNullOrWhiteSpace($ReferencePdfPath)-and$script:WordPageCache.ContainsKey($key)){return [int]$script:WordPageCache[$key]};$arguments=@('-NoProfile','-ExecutionPolicy','Bypass','-File',$script:WordInspectorPath,'-DocxPath',[IO.Path]::GetFullPath($Path));if(-not[string]::IsNullOrWhiteSpace($ReferencePdfPath)){$arguments+=@('-ReferencePdfPath',[IO.Path]::GetFullPath($ReferencePdfPath))};$previous=$ErrorActionPreference;try{$ErrorActionPreference='Continue';$output=& powershell @arguments 2>&1|Out-String;$exit=$LASTEXITCODE}finally{$ErrorActionPreference=$previous};if($exit-ne0){Fail-Quality $Id 'WORD_READ'};try{$result=$output.Trim()|ConvertFrom-Json}catch{Fail-Quality $Id 'WORD_READ'};if(-not$result.ok-or[int]$result.pages-lt1){Fail-Quality $Id 'WORD_READ'};$script:WordPageCache[$key]=[int]$result.pages;return [int]$result.pages}
function Get-QualityXmlText($Node,$Manager){$builder=[Text.StringBuilder]::new();foreach($child in @($Node.SelectNodes('.//w:t | .//w:tab',$Manager))){if($child.LocalName-eq'tab'){[void]$builder.Append("`t")}else{[void]$builder.Append([string]$child.InnerText)}};return $builder.ToString()}
function Get-QualityTextSegments([string]$Text,[int]$Width){if($Text.Length-eq0){return ,''};$result=[Collections.Generic.List[string]]::new();$current=[Text.StringBuilder]::new();$enumerator=[Globalization.StringInfo]::GetTextElementEnumerator($Text);$count=0;while($enumerator.MoveNext()){if($count-eq$Width){$result.Add($current.ToString());[void]$current.Clear();$count=0};[void]$current.Append([string]$enumerator.Current);$count++};if($current.Length){$result.Add($current.ToString())};return $result.ToArray()}
function Test-QualityRelativePath([string]$Path){if([string]::IsNullOrWhiteSpace($Path)-or[IO.Path]::IsPathRooted($Path)-or$Path.Contains('\')-or$Path.StartsWith('/')-or$Path.Contains([char]0)){return $false};$segments=@($Path.Split('/'));return ($segments.Count-gt0-and@($segments|Where-Object{[string]::IsNullOrWhiteSpace($_)-or$_-in@('.','..')}).Count-eq0)}
function Assert-QualityFile([string]$Path,[string]$Id){if(-not(Test-Path -LiteralPath $Path -PathType Leaf)){Fail-Quality $Id 'MISSING'};$item=Get-Item -LiteralPath $Path -Force;if(($item.Attributes-band[IO.FileAttributes]::ReparsePoint) -ne 0){Fail-Quality $Id 'REPARSE'};return $item}
function Read-ZipEntryText($Archive,[string]$Name,[string]$Id){$entry=$Archive.GetEntry($Name);if($null-eq$entry){Fail-Quality $Id 'DOCX_STRUCTURE'};$reader=[IO.StreamReader]::new($entry.Open(),[Text.Encoding]::UTF8,$true);try{return ($reader.ReadToEnd())}finally{$reader.Dispose()}}
function Get-DocxQualityMetrics([string]$Path,[string]$Id){
    Add-Type -AssemblyName System.IO.Compression;Add-Type -AssemblyName System.IO.Compression.FileSystem;$archive=[IO.Compression.ZipFile]::OpenRead($Path)
    try{
        $names=@($archive.Entries|ForEach-Object FullName);if(@($names|Group-Object|Where-Object Count -ne 1).Count){Fail-Quality $Id 'DOCX_STRUCTURE'}
        [xml]$document=Read-ZipEntryText $archive 'word/document.xml' $Id;[xml]$app=Read-ZipEntryText $archive 'docProps/app.xml' $Id;[xml]$settings=Read-ZipEntryText $archive 'word/settings.xml' $Id
        $w='http://schemas.openxmlformats.org/wordprocessingml/2006/main';$r='http://schemas.openxmlformats.org/officeDocument/2006/relationships';$a='http://schemas.openxmlformats.org/drawingml/2006/main';$v='urn:schemas-microsoft-com:vml';$manager=[Xml.XmlNamespaceManager]::new($document.NameTable);$manager.AddNamespace('w',$w);$manager.AddNamespace('r',$r);$manager.AddNamespace('a',$a);$manager.AddNamespace('v',$v)
        $text=@($document.SelectNodes('//w:t',$manager)|ForEach-Object{[string]$_.InnerText})-join'';$scanText=[Text.StringBuilder]::new();foreach($xmlEntry in @($archive.Entries|Where-Object{$_.FullName-match'(?i)(\.xml$|\.rels$)'})){$reader=[IO.StreamReader]::new($xmlEntry.Open(),[Text.Encoding]::UTF8,$true);try{$raw=$reader.ReadToEnd();[void]$scanText.Append(' ').Append($raw);try{[xml]$scanXml=$raw;[void]$scanText.Append(' ').Append([string]$scanXml.InnerText);if($xmlEntry.FullName-match'^docProps/(core|app)\.xml$'){foreach($identityNode in @($scanXml.SelectNodes('//*[local-name()="creator" or local-name()="lastModifiedBy" or local-name()="Company" or local-name()="Manager"]'))){$identity=[string]$identityNode.InnerText;if(-not[string]::IsNullOrWhiteSpace($identity)-and$identity-ne'【申请人填写】'){Fail-Quality $Id 'IDENTITY_METADATA'}}}}catch{if($_.Exception.Message-like'QUALITY_*'){throw}};if($xmlEntry.FullName-match'^word/(header|footer)[0-9]+\.xml$'){[xml]$part=$raw;$partManager=[Xml.XmlNamespaceManager]::new($part.NameTable);$partManager.AddNamespace('w',$w);$text+=@($part.SelectNodes('//w:t',$partManager)|ForEach-Object{[string]$_.InnerText})-join''}}finally{$reader.Dispose()}};$paragraphNodes=@($document.SelectNodes('//w:p',$manager));$paragraphs=$paragraphNodes.Count;$headingTexts=[Collections.Generic.List[string]]::new();$paragraphRecords=[Collections.Generic.List[object]]::new();$tableSections=[Collections.Generic.List[object]]::new();$numberedParagraphs=0;$headingByLevel=@{};foreach($child in @($document.SelectNodes('/w:document/w:body/*',$manager))){if($child.LocalName-eq'p'){$paragraphText=Get-QualityXmlText $child $manager;$styleNode=$child.SelectSingleNode('./w:pPr/w:pStyle',$manager);$style=if($null-eq$styleNode){''}else{$styleNode.GetAttribute('val',$w)};$level=99;if($style-match'(?i)heading|标题|^[1-9]$'){$digits=[regex]::Match($style,'[1-9]');$level=if($digits.Success){[int]$digits.Value}else{1};foreach($key in @($headingByLevel.Keys|Where-Object{[int]$_-ge$level})){$headingByLevel.Remove($key)};$headingByLevel[$level]=$paragraphText;$headingTexts.Add($paragraphText)};$sectionPath=@($headingByLevel.Keys|Sort-Object|ForEach-Object{$headingByLevel[$_]})-join' > ';$numbered=$null-ne$child.SelectSingleNode('./w:pPr/w:numPr',$manager);if($numbered){$numberedParagraphs++};$pageBreak=$null-ne$child.SelectSingleNode('.//w:br[@w:type="page"]',$manager);$paragraphRecords.Add([pscustomobject]@{text=$paragraphText;style=$style;headingLevel=$level;sectionPath=$sectionPath;numbered=$numbered;pageBreak=$pageBreak})}elseif($child.LocalName-eq'tbl'){$tableText=Get-QualityXmlText $child $manager;$sectionPath=@($headingByLevel.Keys|Sort-Object|ForEach-Object{$headingByLevel[$_]})-join' > ';$tableSections.Add([pscustomobject]@{sectionPath=$sectionPath;text=$tableText})}};$tables=$tableSections.Count;$tableTexts=@($tableSections|ForEach-Object text);$bookmarks=@($document.SelectNodes('//w:bookmarkStart',$manager)|ForEach-Object{$_.GetAttribute('name',$w)}|Where-Object{$_});$drawingImages=@($document.SelectNodes('//a:blip',$manager)|ForEach-Object{$_.GetAttribute('embed',$r)}|Where-Object{$_});$vmlImages=@($document.SelectNodes('//v:imagedata',$manager)|ForEach-Object{$_.GetAttribute('id',$r)}|Where-Object{$_});$usedImages=@($drawingImages+$vmlImages|Sort-Object -Unique)
        $variables=@{};$settingsManager=[Xml.XmlNamespaceManager]::new($settings.NameTable);$settingsManager.AddNamespace('w',$w);foreach($node in @($settings.SelectNodes('//w:docVar',$settingsManager))){$variables[$node.GetAttribute('name',$w)]=$node.GetAttribute('val',$w)}
        $mediaHashes=[Collections.Generic.List[string]]::new();if($usedImages.Count){[xml]$rels=Read-ZipEntryText $archive 'word/_rels/document.xml.rels' $Id;$relNs='http://schemas.openxmlformats.org/package/2006/relationships';$relManager=[Xml.XmlNamespaceManager]::new($rels.NameTable);$relManager.AddNamespace('p',$relNs);foreach($imageId in $usedImages){$node=$rels.SelectSingleNode("//p:Relationship[@Id='$imageId']",$relManager);if($null-eq$node-or$node.GetAttribute('Type')-notlike'*/image'){Fail-Quality $Id 'MEDIA_RELATION'};$target=$node.GetAttribute('Target').Replace('\','/');if($target.StartsWith('/')-or$target.Contains('../')){Fail-Quality $Id 'MEDIA_RELATION'};$entry=$archive.GetEntry('word/'+$target);if($null-eq$entry){Fail-Quality $Id 'MEDIA_RELATION'};$stream=$entry.Open();try{$sha=[Security.Cryptography.SHA256]::Create();try{$mediaHashes.Add(([BitConverter]::ToString($sha.ComputeHash($stream))).Replace('-','').ToLowerInvariant())}finally{$sha.Dispose()}}finally{$stream.Dispose()}}}
        $pageNode=$app.SelectSingleNode('//*[local-name()="Pages"]');try{$pages=[int]$pageNode.InnerText}catch{Fail-Quality $Id 'PAGES'};if($pages -lt 1){Fail-Quality $Id 'PAGES'}
        $normalized=$text.Normalize([Text.NormalizationForm]::FormKC);$visibleCharacters=[regex]::Matches($normalized,'[\p{L}\p{Nd}]').Count
        return [pscustomobject]@{text=$text;scanText=($text+' '+$scanText.ToString());characters=$visibleCharacters;paragraphs=$paragraphs;paragraphRecords=$paragraphRecords.ToArray();tables=$tables;tableTexts=$tableTexts;tableSections=$tableSections.ToArray();headingTexts=$headingTexts.ToArray();numberedParagraphs=$numberedParagraphs;bookmarks=$bookmarks;pageMetadata=$pages;pages=$pages;mediaHashes=$mediaHashes.ToArray();sha256=Get-QualityHash $Path;variables=$variables}
    }catch{if($_.Exception.Message-like'QUALITY_*'){throw};Fail-Quality $Id 'DOCX_READ'}finally{$archive.Dispose()}
}
function Get-PdfQualityPageCount([string]$Path,[string]$Id){
    try{
        $cacheKey=Get-QualityHash $Path;if($script:PdfMetricCache.ContainsKey($cacheKey)){return $script:PdfMetricCache[$cacheKey]}
        if(-not(Test-Path -LiteralPath $script:PdfInspectorPath -PathType Leaf)){throw 'PDF_INSPECTOR_MISSING'};$previous=$ErrorActionPreference;try{$ErrorActionPreference='Continue';$output=& powershell -NoProfile -ExecutionPolicy Bypass -File $script:PdfInspectorPath -PdfPath ([IO.Path]::GetFullPath($Path)) 2>&1|Out-String;$exitCode=$LASTEXITCODE}finally{$ErrorActionPreference=$previous};if($exitCode-ne0){throw 'PDF_INSPECTOR_FAILED'}
        $line=@($output-split"`r?`n"|Where-Object{$_-match'^\{"ok":true,'}|Select-Object -Last 1);if($line.Count-ne1){throw 'PDF_INSPECTOR_OUTPUT'};$result=$line[0]|ConvertFrom-Json -ErrorAction Stop;if([int]$result.pages-lt1-or@($result.pageDigests).Count-ne[int]$result.pages-or@($result.pageDigests|Where-Object{$_-notmatch'^[0-9a-f]{64}$'}).Count){throw 'PDF_INSPECTOR_RESULT'};if($result.nonblank-ne$true){Fail-Quality $Id 'PDF_BLANK'};$normalized=[pscustomobject]@{pages=[int]$result.pages;nonblank=$true;pageDigests=@($result.pageDigests)};$script:PdfMetricCache[$cacheKey]=$normalized;return $normalized
    }catch{if($_.Exception.Message-like'QUALITY_*'){throw};Fail-Quality $Id 'PDF_READ'}
}
function Test-ForbiddenQualityText([string]$Text,[string]$Id){if($Text-match'(?i)gh[pousr]_[A-Za-z0-9_]{16,}|github_pat_[A-Za-z0-9_]{20,}|RZ_PASSWORD\s*=\s*[^\s"'',;]{4,}|(?:password|passwd|token|secret|api[_-]?key)\s*[:=]\s*(?:"[^"\r\n]{4,}"|&quot;[^&\r\n]{4,}&quot;|''[^''\r\n]{4,}''|[A-Za-z0-9+/=_-]{20,})|(?<![A-Za-z0-9])(?:[A-Za-z]:[\\/]|\\\\[^\\\s]+\\)|/(?:home|Users|tmp)/[^\s<"]+'){Fail-Quality $Id 'FORBIDDEN_TEXT'};if($Id-ne'source'-and$Text-match'(?i)(?:password|passwd|token|secret|api[_-]?key)\s*[:=]\s*[^\s"'',;]{4,}'){Fail-Quality $Id 'FORBIDDEN_TEXT'}}
function Test-InternalQualityIds($Facts,[string]$Text,[string]$Id){$ids=@($Facts.commands.id)+@($Facts.roles.id)+@($Facts.modules.id)+@($Facts.entities.id)+@($Facts.entities|ForEach-Object{@($_.fields.id)})+@('list','view');foreach($internal in @($ids|Where-Object{-not[string]::IsNullOrWhiteSpace([string]$_)}|Sort-Object -Unique)){if($Text-cmatch('(?<![A-Za-z0-9_\.])'+[regex]::Escape([string]$internal)+'(?![A-Za-z0-9_\.])')){Fail-Quality $Id 'INTERNAL_ID'}}}
function Get-QualitySourceExpectation($Facts,$Plan){
    $pages=@($Plan.pages);if([string]$Plan.planVersion-ne'1.0'-or[int]$Plan.linesPerPage-ne50-or[int]$Plan.displayWidth-ne55-or[string]$Plan.sourceManifestSha256-cne[string]$Facts.source.sha256-or[string]$Plan.selectionSha256-notmatch'^[0-9a-f]{64}$'-or[int]$Plan.expectedPageCount-ne$pages.Count-or[int]$Plan.totalFiles-ne[int]$Facts.source.totalFiles-or[int]$Plan.totalLogicalLines-ne[int]$Facts.source.totalLines){throw 'QUALITY_SOURCE_PLAN'}
    $expectedSourcePages=if([int]$Plan.totalSourcePages-le60){@(1..([int]$Plan.totalSourcePages))}else{@(1..30)+@(([int]$Plan.totalSourcePages-29)..([int]$Plan.totalSourcePages))};if(-not(Test-ExactQualityArray $expectedSourcePages @($pages|ForEach-Object{[int]$_.sourcePage}))){throw 'QUALITY_SOURCE_PLAN'}
    $selectedFiles=[Collections.Generic.List[string]]::new();$canonical=[Collections.Generic.List[string]]::new();$expectedPages=[Collections.Generic.List[object]]::new();$selectedLineCount=0
    foreach($page in $pages){
        $lines=@($page.lines);$mappings=@($page.mappings);$minimum=if([int]$page.outputPage-eq$pages.Count){1}else{50};if([int]$page.outputPage-ne$expectedPages.Count+1-or$lines.Count-gt50-or$lines.Count-lt$minimum){throw 'QUALITY_SOURCE_PLAN'}
        foreach($line in $lines){$path=[string]$line.path;if(-not(Test-QualityRelativePath $path)-or[int]$line.lineNumber-lt1-or[int]$line.continuation-lt0-or[Globalization.StringInfo]::ParseCombiningCharacters([string]$line.text).Count-gt55){throw 'QUALITY_SOURCE_PLAN'};if(-not$selectedFiles.Contains($path)){$selectedFiles.Add($path)};$bytes=[Text.UTF8Encoding]::new($false).GetBytes([string]$line.text);$hash=[BitConverter]::ToString(([Security.Cryptography.SHA256]::Create().ComputeHash($bytes))).Replace('-','').ToLowerInvariant();$canonical.Add(('{0}|{1}|{2}|{3}|{4}'-f$page.sourcePage,$path,$line.lineNumber,$line.continuation,$hash));$selectedLineCount++}
        $expectedMappingPaths=@($lines|ForEach-Object{[string]$_.path}|Select-Object -Unique);$derivedMappings=[Collections.Generic.List[object]]::new();foreach($mappingPath in $expectedMappingPaths){$parts=@(Get-QualityTextSegments $mappingPath 48);for($part=0;$part-lt$parts.Count;$part++){$derivedMappings.Add([pscustomobject]@{path=$mappingPath;part=$part;text=[string]$parts[$part]})}};if($mappings.Count-ne$derivedMappings.Count){throw 'QUALITY_SOURCE_PLAN'};for($mappingIndex=0;$mappingIndex-lt$mappings.Count;$mappingIndex++){if([string]$mappings[$mappingIndex].path-cne[string]$derivedMappings[$mappingIndex].path-or[int]$mappings[$mappingIndex].part-ne[int]$derivedMappings[$mappingIndex].part-or[string]$mappings[$mappingIndex].text-cne[string]$derivedMappings[$mappingIndex].text){throw 'QUALITY_SOURCE_PLAN'}}
        $expected=[Collections.Generic.List[string]]::new();foreach($line in $lines){if(-not[string]::IsNullOrWhiteSpace([string]$line.text)){$expected.Add([string]$line.text)}};$expectedPages.Add($expected.ToArray())
    }
    if(-not(Test-ExactQualityArray $selectedFiles.ToArray() @($Plan.selectedFiles))-or$selectedLineCount-ne[int]$Plan.selectedLineCount){throw 'QUALITY_SOURCE_PLAN'};$trim=[int]$Plan.totalSourcePages-gt60;$first=if($trim){'1-30'}else{'1-'+[int]$Plan.totalSourcePages};$last=if($trim){([int]$Plan.totalSourcePages-29).ToString()+'-'+[int]$Plan.totalSourcePages}else{$null};if([bool]$Plan.trimRequired-ne$trim-or[string]$Plan.firstRange-cne$first-or[string]$Plan.lastRange-cne[string]$last){throw 'QUALITY_SOURCE_PLAN'};$metadata=[string]$Facts.source.sha256+'|50|55|'+[int]$Plan.totalFiles+'|'+[int]$Plan.totalLogicalLines+'|'+[int]$Plan.totalPrintLines+'|'+[int]$Plan.totalSourcePages+'|'+$trim+'|'+$first+'|'+[string]$last+'|'+($expectedSourcePages-join',');$selection=[BitConverter]::ToString(([Security.Cryptography.SHA256]::Create().ComputeHash([Text.UTF8Encoding]::new($false).GetBytes($metadata+"`n"+($canonical-join"`n"))))).Replace('-','').ToLowerInvariant();if($selection-cne[string]$Plan.selectionSha256){throw 'QUALITY_SOURCE_PLAN'};return $expectedPages.ToArray()
}
function Test-QualitySourceDocument($Metrics,$ExpectedPages){$actualPages=[Collections.Generic.List[object]]::new();$current=[Collections.Generic.List[string]]::new();foreach($record in @($Metrics.paragraphRecords)){if($record.pageBreak){if($current.Count){$actualPages.Add($current.ToArray());$current=[Collections.Generic.List[string]]::new()};continue};if(-not[string]::IsNullOrWhiteSpace([string]$record.text)){$current.Add([string]$record.text)}};if($current.Count){$actualPages.Add($current.ToArray())};if($actualPages.Count-ne@($ExpectedPages).Count){throw 'QUALITY_SOURCE_CONTENT'};for($i=0;$i-lt$actualPages.Count;$i++){if(-not(Test-ExactQualityArray $actualPages[$i] $ExpectedPages[$i])){throw 'QUALITY_SOURCE_CONTENT'}}}

function Test-StandardDocumentSet {
    [CmdletBinding()]param([Parameter(Mandatory)]$Facts,[Parameter(Mandatory)][string]$DocumentRoot,[Parameter(Mandatory)][string[]]$ExpectedScreenshots,[Parameter(Mandatory)]$SourcePlan)
    if([string]$Facts.factVersion-ne'1.0'){throw 'QUALITY_FACTS_INVALID'};$root=[IO.Path]::GetFullPath($DocumentRoot);if(-not(Test-Path -LiteralPath $root -PathType Container)){throw 'QUALITY_ROOT_MISSING'};$rootItem=Get-Item $root -Force;if(($rootItem.Attributes-band[IO.FileAttributes]::ReparsePoint) -ne 0){throw 'QUALITY_ROOT_REPARSE'}
