    $expectedNames=[Collections.Generic.List[string]]::new();foreach($definition in @($config.documents)){$expectedNames.Add([string]$definition.docx);if($null-ne$definition.pdf){$expectedNames.Add([string]$definition.pdf)}};$actual=@(Get-ChildItem -LiteralPath $root -File|ForEach-Object Name|Sort-Object);if(-not(Test-ExactQualityArray $actual @($expectedNames|Sort-Object))){throw 'QUALITY_DOCUMENT_SET'}
    $sourceExpectation=Get-QualitySourceExpectation $Facts $SourcePlan
