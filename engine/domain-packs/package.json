{
  "name": "rz-domain-pack-composer",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic domain pack protocol and blueprint composer",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test": "npm run test:unit && npm run test:integration",
    "build": "tsc -p tsconfig.json",
    "compose": "node --import tsx src/cli.ts"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
