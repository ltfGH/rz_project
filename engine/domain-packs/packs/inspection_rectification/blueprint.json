      ],
      "inspection_event": [
        { "code": "IEVT-001", "task_code": "ITASK-001", "event_type": "created", "from_status": null, "to_status": "pending", "actor_id": "计划岗位-01", "content": "初始化巡检任务", "occurred_at": "2026-01-01T08:00:00.000Z" }
      ]
    }
  }
}
