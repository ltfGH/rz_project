# Release builds require four independently generated scrypt digests.
# Set RZ_PASSWORD to a chosen password and run:
#   node engine/desktop-runtime/tools/hash-password.cjs
RZ_REFERENCE_DISPATCHER_PASSWORD_DIGEST=<scrypt-digest>
RZ_REFERENCE_OPERATOR_PASSWORD_DIGEST=<scrypt-digest>
RZ_REFERENCE_REVIEWER_PASSWORD_DIGEST=<scrypt-digest>
RZ_REFERENCE_ADMINISTRATOR_PASSWORD_DIGEST=<scrypt-digest>
